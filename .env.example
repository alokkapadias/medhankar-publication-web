# ==============================================================================
# MEDHANKAR GRAPHICS AND PUBLICATIONS PRIVATE LIMITED
# Environment Variables Configuration
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
# Found in Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anon Key
# Found in Supabase Dashboard -> Project Settings -> API -> Project API keys (anon / public)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: Set to 'true' to allow explicitly toggled Demo Mode on local development
# Note: Demo mode is strictly disabled in production builds unless explicitly enabled for review.
VITE_ENABLE_DEMO_AUTH=true
